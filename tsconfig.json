{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "vision",
    "cli",
    "tests"
  ],
  "exclude": [
    "tests/fixtures",
    "tests/block-questions.test.ts",
    "tests/stack-fixtures",
    "tests/arch-fixtures",
    "tests/corpus",
    "tests/app-*.test.ts"
  ]
}
