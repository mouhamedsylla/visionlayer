{
  "version": 1,
  "environments": [
    "dev",
    "prod"
  ],
  "components": [
    {
      "id": "database:firestore-default",
      "name": "Firestore",
      "kind": "database",
      "source": {
        "kind": "extracted",
        "path": "firebase.json",
        "line": 2
      },
      "environments": [
        "all"
      ],
      "attrs": {
        "base": "(default)",
        "règles": "firestore.rules"
      },
      "perEnv": {
        "dev": {
          "projet": "acme-dev-123"
        },
        "prod": {
          "projet": "acme-prod-456"
        }
      }
    },
    {
      "id": "host:firebase-hosting-web",
      "name": "Firebase Hosting · web",
      "kind": "host",
      "source": {
        "kind": "extracted",
        "path": "firebase.json",
        "line": 6
      },
      "environments": [
        "all"
      ],
      "attrs": {
        "public": "dist/web",
        "réécritures": "** → /index.html"
      },
      "perEnv": {
        "dev": {
          "projet": "acme-dev-123",
          "site": "acme-dev-web"
        },
        "prod": {
          "projet": "acme-prod-456",
          "site": "acme-web"
        }
      }
    },
    {
      "id": "image:render/Dockerfile",
      "name": "render/Dockerfile",
      "kind": "image",
      "source": {
        "kind": "extracted",
        "path": "render/Dockerfile",
        "line": 2
      },
      "environments": [
        "all"
      ],
      "attrs": {
        "cmd": "[\"python\", \"-m\", \"render\"]",
        "base": "python:3.11-slim",
        "expose": "8080"
      }
    },
    {
      "id": "job:cloudbuild-cloudbuild",
      "name": "Cloud Build",
      "kind": "job",
      "source": {
        "kind": "extracted",
        "path": "cloudbuild.yaml",
        "line": 1
      },
      "environments": [
        "all"
      ],
      "attrs": {
        "étapes": "app, deploy",
        "images": "node:20, gcr.io/google.com/cloudsdktool/cloud-sdk",
        "logs": "CLOUD_LOGGING_ONLY"
      }
    },
    {
      "id": "job:script-deploy-dev",
      "name": "script · deploy:dev",
      "kind": "job",
      "source": {
        "kind": "extracted",
        "path": "package.json",
        "line": 6
      },
      "environments": [
        "all"
      ],
      "attrs": {
        "commande": "pnpm build && firebase deploy --only hosting --project dev"
      }
    },
    {
      "id": "job:script-deploy-prod",
      "name": "script · deploy:prod",
      "kind": "job",
      "source": {
        "kind": "extracted",
        "path": "package.json",
        "line": 7
      },
      "environments": [
        "all"
      ],
      "attrs": {
        "commande": "pnpm build && firebase deploy --only hosting --project prod"
      }
    },
    {
      "id": "job:script-deploy-render",
      "name": "script · deploy:render",
      "kind": "job",
      "source": {
        "kind": "extracted",
        "path": "package.json",
        "line": 8
      },
      "environments": [
        "all"
      ],
      "attrs": {
        "commande": "gcloud run deploy video-render --source render --project acme-prod-456"
      }
    },
    {
      "id": "job:script-functions-deploy",
      "name": "script · functions · deploy",
      "kind": "job",
      "source": {
        "kind": "extracted",
        "path": "functions/package.json",
        "line": 3
      },
      "environments": [
        "all"
      ],
      "attrs": {
        "commande": "firebase deploy --only functions"
      }
    },
    {
      "id": "service:firebase-functions-default",
      "name": "Cloud Functions",
      "kind": "service",
      "source": {
        "kind": "extracted",
        "path": "firebase.json",
        "line": 15
      },
      "environments": [
        "all"
      ],
      "attrs": {
        "source": "functions",
        "codebase": "default",
        "predeploy": "npm --prefix \"$RESOURCE_DIR\" run build"
      },
      "perEnv": {
        "dev": {
          "projet": "acme-dev-123"
        },
        "prod": {
          "projet": "acme-prod-456"
        }
      }
    },
    {
      "id": "service:video-render",
      "name": "video-render",
      "kind": "service",
      "source": {
        "kind": "extracted",
        "path": "firebase.json",
        "line": 10
      },
      "environments": [
        "all"
      ],
      "attrs": {
        "plateforme": "Cloud Run",
        "région": "europe-west1",
        "source": "render"
      }
    },
    {
      "id": "storage:firebase-storage",
