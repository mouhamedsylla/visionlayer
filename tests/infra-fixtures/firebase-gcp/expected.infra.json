      "kind": "storage",
      "source": {
        "kind": "extracted",
        "path": "firebase.json",
        "line": 3
      },
      "environments": [
        "all"
      ],
      "attrs": {
        "règles": "storage.rules"
      },
      "perEnv": {
        "dev": {
          "projet": "acme-dev-123"
        },
        "prod": {
          "projet": "acme-prod-456"
        }
      }
    }
  ],
