    "archi": "tsx cli/archi.ts",
    "facts": "tsx cli/facts.ts",
    "hook": "tsx cli/hook.ts",
    "cost": "tsx cli/cost.ts",
    "knowledge": "tsx cli/knowledge.ts",
    "packs": "tsx cli/pack.ts",
    "mcp": "tsx integrations/agents/server.ts",
    "ui": "tsx cli/ui.ts",
    "test": "tsx --test tests/**/*.test.ts",
